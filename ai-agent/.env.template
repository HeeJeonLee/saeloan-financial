# ================================================================
# 새론금융대부중개 AI 에이전트 — 환경 변수 설정
# ================================================================
# 사용 방법:
#   1. 이 파일을 복사해서 .env 라는 이름으로 저장하세요
#   2. 각 항목에 실제 값을 입력하세요
#   3. .env 파일은 절대 GitHub에 올리면 안 됩니다 (자동 차단)
# ================================================================

# ──────────────────────────────────────────────────────────────
# [필수] Claude AI 키 — 없으면 에이전트 실행 불가
# 발급: https://console.anthropic.com → API Keys
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-여기에_발급받은_키_입력

# ──────────────────────────────────────────────────────────────
# [Instagram 자동게시용] — 없으면 파일 저장만 됨
# 설정하면: 매일 오전 9시 자동으로 Instagram에 게시됩니다
#
# INSTAGRAM_USER_ID       : Instagram 비즈니스 계정의 숫자 ID
# INSTAGRAM_ACCESS_TOKEN  : 장기 액세스 토큰 (60일 유효)
# OG_IMAGE_BASE_URL       : 홈페이지 Vercel 배포 URL
# ──────────────────────────────────────────────────────────────
INSTAGRAM_USER_ID=숫자로_된_계정ID
INSTAGRAM_ACCESS_TOKEN=EAAxxxxx_여기에_토큰_입력
OG_IMAGE_BASE_URL=https://여기에_vercel_주소.vercel.app

# ──────────────────────────────────────────────────────────────
# [Telegram 완료알림용] — 없으면 알림 없음
# 설정하면: 매일 게시 완료 시 이희전 폰으로 알림 전송됩니다
#
# TELEGRAM_BOT_TOKEN  : @BotFather 에서 /newbot 으로 생성
# TELEGRAM_CHAT_ID    : @userinfobot 에게 메시지 → 숫자 ID 확인
# ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxx_여기에_봇토큰
TELEGRAM_CHAT_ID=이희전_텔레그램_숫자ID

# ──────────────────────────────────────────────────────────────
# [네이버 블로그 자동게시용] — 없으면 파일 저장만 됨
# ──────────────────────────────────────────────────────────────
# [YouTube Shorts 완전 자동화] — 없으면 스크립트만 텔레그램 전송됨
# 설정하면: 매일 오전 9시 YouTube Shorts 자동 생성 & 업로드!
#
# ① ElevenLabs TTS (한국어 자연스러운 AI 목소리)
#   발급: https://elevenlabs.io → 가입 → Profile → API Key
#   비용: $5/월 (한국어 목소리 포함, 영상 60개 이상 가능)
#
# ② YouTube OAuth 설정 (1회, 약 15분)
#   1. https://console.cloud.google.com 접속 → 새 프로젝트 생성
#   2. YouTube Data API v3 활성화
#   3. OAuth 2.0 클라이언트 ID 생성 (데스크톱 앱)
#   4. 1회 인증 → refresh_token 확보 (저에게 안내 요청하세요)
# ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=여기에_ElevenLabs_API_키_입력
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
YOUTUBE_CLIENT_ID=여기에_Google_OAuth_클라이언트_ID
YOUTUBE_CLIENT_SECRET=여기에_Google_OAuth_클라이언트_시크릿
YOUTUBE_REFRESH_TOKEN=여기에_YouTube_refresh_token

# ──────────────────────────────────────────────────────────────
# [Threads 크로스포스팅] — Instagram 설정 시 자동 연동
# 별도 토큰 없으면 Instagram 토큰 재사용 (추가 설정 불필요)
# Threads 전용 토큰이 있으면 아래에 입력
# ──────────────────────────────────────────────────────────────
THREADS_ACCESS_TOKEN=Instagram_토큰과_동일하게_입력_또는_비워두기
